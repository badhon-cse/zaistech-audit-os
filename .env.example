# Supabase (free tier) -- from your Supabase project's Settings > API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=xxxxx

# Claude Agent SDK, authenticated with your Pro/Max subscription (not a Console API key).
# Generate with: claude setup-token   (run once on your own machine, then paste the token here)
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-xxxxx
# IMPORTANT: do NOT also set ANTHROPIC_API_KEY -- if both are present the SDK
# prefers the API key and bills your Console account instead of the Pro plan credit.

# Google PageSpeed Insights (free, 25,000 requests/day) -- from Google Cloud Console
PAGESPEED_API_KEY=xxxxx

# Optional, Phase 3
INSTANTLY_API_KEY=
INSTANTLY_CAMPAIGN_ID=
